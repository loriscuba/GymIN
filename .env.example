# ---- Supabase ----
# In locale con la Supabase CLI questi valori li stampa `supabase status`.
# In cloud li trovi in Project Settings > API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOi...            # chiave pubblica (frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # chiave privata (solo mailer, MAI nel frontend)

# ---- SMTP / Mailpit ----
# In sviluppo puntiamo a Mailpit: nessuna mail esce davvero, le vedi su http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GymIN <no-reply@gymin.local>

# ---- Mailer manuale realtime ----
MAILER_PORT=3001
MAILER_API_KEY=

# ---- Scheduler ----
# Cron del job giornaliero (default: ogni giorno alle 08:00). Formato standard cron.
MAIL_CRON=0 8 * * *
