# GymIN Accessi — variabili d'ambiente (copia in .env, NON committare .env)
# Usate da `npm run dev` (genera /config.js al volo) e da `npm run build` (scrive dist/config.js).

# Progetto Supabase (lo stesso di GymIN). Solo la chiave ANON (pubblica): MAI la service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Opzionale: schema del database (vuoto = public; "test" = ambiente di test di GymIN)
DB_SCHEMA=

# Opzionali per il terminale
TIMEOUT_ONLINE_MS=2000          # oltre questo tempo la chiamata al server è considerata fallita
RITARDO_SUONI_MS=150            # attesa dopo la lettura, per non sovrapporsi al bip del lettore
DURATA_ESITO_MS=3000            # dopo quanto la schermata torna in attesa

# Solo sviluppo: porta del server locale e DB per il seed demo (mai la produzione!)
PORT=5174
DEV_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
